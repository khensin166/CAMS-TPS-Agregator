    {
      "id": 1,
      "title": "On-Premise Real-Time TPS",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "mssql", "uid": "mssql-cams" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 500 },
              { "color": "red", "value": 900 }
            ]
          },
          "unit": "reqps"
        }
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }
      },
      "targets": [
        {
          "rawSql": "SELECT TOP 1 metric_time AS time, total_transactions AS value FROM dbo.tps_metrics WHERE source_name = 'onprem' ORDER BY metric_time DESC;",
          "refId": "A",
          "format": "table"
        }
      ]
    },
