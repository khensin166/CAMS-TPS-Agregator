    {
      "id": 5,
      "title": "TPS Metrics Time Series (1s Granularity)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 7 },
      "datasource": { "type": "mssql", "uid": "mssql-cams" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15
          },
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "rawSql": "SELECT metric_time AS time, total_transactions AS [On-Prem Total], success_transactions AS [On-Prem Success], failed_transactions AS [On-Prem Failed] FROM dbo.tps_metrics WHERE source_name = 'onprem' AND metric_time >= $__timeFrom() AND metric_time <= $__timeTo() ORDER BY metric_time ASC;",
          "refId": "OnPrem",
          "format": "time_series"
        },
        {
          "rawSql": "SELECT metric_time AS time, total_transactions AS [Cloud Total], success_transactions AS [Cloud Success], failed_transactions AS [Cloud Failed] FROM dbo.tps_metrics WHERE source_name = 'cloud' AND metric_time >= $__timeFrom() AND metric_time <= $__timeTo() ORDER BY metric_time ASC;",
          "refId": "Cloud",
          "format": "time_series"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 102,
      "title": "Periodic Summaries (Daily / Weekly / Monthly)",
      "type": "row"
    },
    {
      "id": 6,
      "title": "TPS Summaries (Calendar Based - Asia/Jakarta)",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 17 },
      "datasource": { "type": "mssql", "uid": "mssql-cams" },
      "targets": [
        {
          "rawSql": "SELECT source_name AS [Source], period_type AS [Period Type], DATEADD(hour, 7, period_start) AS [Period Start (WIB)], DATEADD(hour, 7, period_end) AS [Period End (WIB)], min_tps AS [Min TPS], max_tps AS [Max TPS], avg_tps AS [Avg TPS], total_transactions AS [Total Transactions], DATEADD(hour, 7, calculated_at) AS [Calculated (WIB)] FROM dbo.tps_summary ORDER BY period_start DESC, source_name ASC;",
          "refId": "Summary",
          "format": "table"
        }
      ]
    }
