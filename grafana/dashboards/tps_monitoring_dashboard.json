    {
      "id": 3,
      "title": "On-Premise Checkpoint Lag",
      "type": "gauge",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "mssql", "uid": "mssql-cams" },
      "fieldConfig": {
        "defaults": {
          "max": 600,
          "min": 0,
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 120 },
              { "color": "red", "value": 300 }
            ]
          }
        }
      },
      "targets": [
        {
          "rawSql": "SELECT DATEDIFF(second, last_processed_until, SYSUTCDATETIME()) AS lag_seconds FROM dbo.tps_checkpoints WHERE source_name = 'onprem';",
          "refId": "A",
          "format": "table"
        }
      ]
    },
