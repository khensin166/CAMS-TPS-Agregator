# ==============================================================================
# Production Environment Configuration Template (.env)
# TO BE POPULATED ON THE PRODUCTION SERVER: 172.24.81.99
# NEVER COMMIT ACTUAL PRODUCTION CREDENTIALS
# ==============================================================================

# Application Configuration
APP_NAME=CAMS-TPS-Agregator
APP_ENV=production
APP_PORT=8080
APP_TIMEZONE=Asia/Jakarta

# Database Configuration (Production SQL Server 172.24.80.169)
DB_HOST=172.24.80.169
DB_PORT=1433
DB_NAME=CAMS_Monitoring
DB_USER=svc_tps_monitor
DB_PASSWORD=REPLACE_WITH_SECURE_PRODUCTION_PASSWORD
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m
DB_COMMAND_TIMEOUT=30s

# Worker A: On-Premise Source (172.18.65.100:9200)
ONPREM_ENABLED=true
ONPREM_SOURCE_NAME=onprem
ONPREM_ES_URL=http://172.18.65.100:9200
ONPREM_ES_USER=elastic
ONPREM_ES_PASSWORD=P@ssw0rd2020
ONPREM_INDEX_PATTERN=cams-service-*,cams-apps-*
ONPREM_TIMESTAMP_FIELD=@timestamp
ONPREM_POLL_INTERVAL=30s
ONPREM_WATERMARK_DELAY=30s
ONPREM_OVERLAP_WINDOW=60s
ONPREM_RETENTION_PERIOD=168h

# Worker B: Cloud Source (10.212.224.172:9200)
CLOUD_ENABLED=true
CLOUD_SOURCE_NAME=cloud
CLOUD_ES_URL=http://10.212.224.172:9200
CLOUD_ES_USER=elastic
CLOUD_ES_PASSWORD=P@ssw0rd2026
CLOUD_INDEX_PATTERN=cams-service-*,cams-apps-*
CLOUD_TIMESTAMP_FIELD=@timestamp
CLOUD_POLL_INTERVAL=30s
CLOUD_WATERMARK_DELAY=30s
CLOUD_OVERLAP_WINDOW=60s
CLOUD_RETENTION_PERIOD=168h
