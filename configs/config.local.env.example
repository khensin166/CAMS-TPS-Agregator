# ==============================================================================
# Local Development Environment Configuration (.env)
# DO NOT COMMIT SECRETS TO VERSION CONTROL
# ==============================================================================

# Application Configuration
APP_NAME=CAMS-TPS-Agregator
APP_ENV=local
APP_PORT=8080
APP_TIMEZONE=Asia/Jakarta

# Database Configuration (Local SQL Server Docker or Developer Instance)
DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=CAMS_Monitoring
DB_USER=sa
DB_PASSWORD=YourLocalStrongPassword!
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m
DB_COMMAND_TIMEOUT=30s

# Worker A: On-Premise Source
ONPREM_ENABLED=true
ONPREM_SOURCE_NAME=onprem
ONPREM_ES_URL=http://127.0.0.1:9200
ONPREM_ES_USER=
ONPREM_ES_PASSWORD=
ONPREM_INDEX_PATTERN=cams-transactions-*
ONPREM_TIMESTAMP_FIELD=@timestamp
ONPREM_POLL_INTERVAL=10s
ONPREM_WATERMARK_DELAY=60s
ONPREM_OVERLAP_WINDOW=120s

# Worker B: Cloud Source
CLOUD_ENABLED=true
CLOUD_SOURCE_NAME=cloud
CLOUD_ES_URL=http://127.0.0.1:9201
CLOUD_ES_USER=
CLOUD_ES_PASSWORD=
CLOUD_INDEX_PATTERN=cams-transactions-*
CLOUD_TIMESTAMP_FIELD=@timestamp
CLOUD_POLL_INTERVAL=10s
CLOUD_WATERMARK_DELAY=60s
CLOUD_OVERLAP_WINDOW=120s
